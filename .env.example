# Copy to .env.local and fill in. Never commit real values.

# Wormhole / binary relay endpoint used by the file-transfer fallback.
# Example: https://wormhole.example.dev
VITE_RELAY_URL=

# Shared token presented to the Wormhole relay. Falls back to "shogun2025"
# in code when unset — set a real value for any non-local deployment.
VITE_AUTH_TOKEN=

# Host name reported by the self-hosted Zen relay (simple-relay.js).
RELAY_HOST=localhost

# Only needed to run the Gemini chat bot: npm run bot:gemini
GEMINI_API_KEY=
