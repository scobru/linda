[Unit]
Description=Linda DHT bootstrap node
After=network-online.target
Wants=network-online.target

[Service]
# Install this folder plus `npm i hyperdht` at /opt/linda-dht.
ExecStart=/usr/bin/node /opt/linda-dht/node.mjs --port 49737
Restart=always
RestartSec=5
DynamicUser=yes

[Install]
WantedBy=multi-user.target
