{
  "expo": {
    "name": "Linda",
    "slug": "linda-pear-mobile",
    "scheme": "linda-pear",
    "version": "1.14.90",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0e121a",
    "splash": {
      "backgroundColor": "#0b0f14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lindapear.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Linda needs camera access to scan QR invite codes and for video calls",
        "NSMicrophoneUsageDescription": "Linda needs microphone access for voice and video calls"
      }
    },
    "android": {
      "backgroundColor": "#0e121a",
      "adaptiveIcon": {
        "backgroundColor": "#0b0f14"
      },
      "package": "com.lindapear.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-bare-kit",
      [
        "expo-camera",
        {
          "cameraPermission": "Linda needs camera access to scan QR invite codes"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Linda needs microphone access to record voice messages"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/notification.wav"
          ]
        }
      ],
      "expo-video"
    ]
  }
}
