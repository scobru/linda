{
  "expo": {
    "name": "Linda",
    "slug": "linda-pear-mobile",
    "scheme": "linda-pear",
    "version": "1.14.18",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0b0f14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lindapear.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Linda needs camera access to scan QR invite codes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0f14"
      },
      "package": "com.lindapear.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-bare-kit",
      [
        "expo-camera",
        {
          "cameraPermission": "Linda needs camera access to scan QR invite codes"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Linda needs microphone access to record voice messages"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/notification.wav"
          ]
        }
      ],
      "expo-video"
    ]
  }
}
