{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "dom"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "react-native"
    ],
    "outDir": "dist",
    "rootDir": "..",
    "paths": {
      "@core/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "src/**/*",
    "../src/types/**/*"
  ],
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
